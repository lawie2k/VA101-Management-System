generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model assignments {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  job_post_id        BigInt           @db.UnsignedBigInt
  job_application_id BigInt           @db.UnsignedBigInt
  client_profile_id  BigInt           @db.UnsignedBigInt
  va_profile_id      BigInt           @db.UnsignedBigInt
  assigned_by        BigInt?          @db.UnsignedBigInt
  status             String?          @default("active") @db.VarChar(100)
  start_date         DateTime?        @db.Date
  end_date           DateTime?        @db.Date
  created_at         DateTime?        @default(now()) @db.Timestamp(0)
  updated_at         DateTime?        @default(now()) @db.Timestamp(0)
  job_posts          job_posts        @relation(fields: [job_post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignments_ibfk_1")
  job_applications   job_applications @relation(fields: [job_application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignments_ibfk_2")
  client_profiles    client_profiles  @relation(fields: [client_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignments_ibfk_4")
  va_profiles        va_profiles      @relation(fields: [va_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignments_ibfk_5")
  users              users?           @relation(fields: [assigned_by], references: [id], onUpdate: NoAction, map: "assignments_ibfk_3")
  contracts          contracts[]
  invoices           invoices[]
  logs               logs[]

  @@index([assigned_by], map: "assigned_by")
  @@index([client_profile_id], map: "client_profile_id")
  @@index([va_profile_id], map: "va_profile_id")
  @@index([job_application_id], map: "job_application_id")
  @@index([job_post_id], map: "job_post_id")
}

model client_profiles {
  id                   BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt            @unique(map: "user_id") @db.UnsignedBigInt
  company_name         String            @db.VarChar(150)
  industry             String?           @db.VarChar(150)
  company_size         String?           @db.VarChar(100)
  company_website      String?           @db.VarChar(255)
  company_description  String?           @db.Text
  billing_contact_name String?           @db.VarChar(150)
  billing_email        String?           @db.VarChar(150)
  billing_phone        String?           @db.VarChar(50)
  status               String?           @default("active") @db.VarChar(50)
  created_at           DateTime?         @default(now()) @db.Timestamp(0)
  updated_at           DateTime?         @default(now()) @db.Timestamp(0)
  assignments          assignments[]
  users                users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_profiles_ibfk_1")
  contracts            contracts[]
  discovery_calls      discovery_calls[]
  invoices             invoices[]
  job_posts            job_posts[]
  shortlists           shortlists[]
}

model contracts {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  assignment_id     BigInt          @db.UnsignedBigInt
  client_profile_id BigInt          @db.UnsignedBigInt
  va_profile_id     BigInt          @db.UnsignedBigInt
  file_url          String          @db.Text
  signed_file_url   String?         @db.Text
  status            String?         @default("draft") @db.VarChar(100)
  expiry_date       DateTime?       @db.Date
  uploaded_by       BigInt?         @db.UnsignedBigInt
  created_at        DateTime?       @default(now()) @db.Timestamp(0)
  archived_at       DateTime?       @db.Timestamp(0)
  assignments       assignments     @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_ibfk_3")
  client_profiles   client_profiles @relation(fields: [client_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_ibfk_1")
  va_profiles       va_profiles     @relation(fields: [va_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contracts_ibfk_2")
  users             users?          @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "contracts_ibfk_4")

  @@index([assignment_id], map: "assignment_id")
  @@index([client_profile_id], map: "client_profile_id")
  @@index([uploaded_by], map: "uploaded_by")
  @@index([va_profile_id], map: "va_profile_id")
}

model interviews {
  id                                          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  job_application_id                          BigInt           @db.UnsignedBigInt
  interview_type                              String           @db.VarChar(100)
  scheduled_by                                BigInt?          @db.UnsignedBigInt
  interviewer_user_id                         BigInt?          @db.UnsignedBigInt
  scheduled_at                                DateTime         @db.DateTime(0)
  duration_minutes                            Int?             @default(30)
  meeting_platform                            String?          @default("Zoom") @db.VarChar(100)
  meeting_link                                String?          @db.Text
  status                                      String?          @default("scheduled") @db.VarChar(100)
  result                                      String?          @default("pending") @db.VarChar(100)
  remarks                                     String?          @db.Text
  completed_at                                DateTime?        @db.Timestamp(0)
  created_at                                  DateTime?        @default(now()) @db.Timestamp(0)
  updated_at                                  DateTime?        @default(now()) @db.Timestamp(0)
  job_applications                            job_applications @relation(fields: [job_application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "interviews_ibfk_1")
  users_interviews_scheduled_byTousers        users?           @relation("interviews_scheduled_byTousers", fields: [scheduled_by], references: [id], onUpdate: NoAction, map: "interviews_ibfk_2")
  users_interviews_interviewer_user_idTousers users?           @relation("interviews_interviewer_user_idTousers", fields: [interviewer_user_id], references: [id], onUpdate: NoAction, map: "interviews_ibfk_3")

  @@index([scheduled_by], map: "scheduled_by")
  @@index([interview_type, status], map: "idx_interviews_type_status")
  @@index([interviewer_user_id], map: "interviewer_user_id")
  @@index([job_application_id], map: "job_application_id")
}

model invoice_receipts {
  id                                        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_id                                BigInt    @db.UnsignedBigInt
  payment_id                                BigInt?   @db.UnsignedBigInt
  file_url                                  String    @db.Text
  file_name                                 String?   @db.VarChar(255)
  uploaded_by                               BigInt?   @db.UnsignedBigInt
  verification_status                       String?   @default("pending_review") @db.VarChar(100)
  verified_by                               BigInt?   @db.UnsignedBigInt
  verified_at                               DateTime? @db.Timestamp(0)
  remarks                                   String?   @db.Text
  created_at                                DateTime? @default(now()) @db.Timestamp(0)
  invoices                                  invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoice_receipts_ibfk_1")
  payments                                  payments? @relation(fields: [payment_id], references: [id], onUpdate: NoAction, map: "invoice_receipts_ibfk_2")
  users_invoice_receipts_uploaded_byTousers users?    @relation("invoice_receipts_uploaded_byTousers", fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "invoice_receipts_ibfk_4")
  users_invoice_receipts_verified_byTousers users?    @relation("invoice_receipts_verified_byTousers", fields: [verified_by], references: [id], onUpdate: NoAction, map: "invoice_receipts_ibfk_3")

  @@index([invoice_id], map: "invoice_id")
  @@index([uploaded_by], map: "uploaded_by")
  @@index([verified_by], map: "verified_by")
  @@index([payment_id], map: "payment_id")
}

model invoices {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  client_profile_id BigInt             @db.UnsignedBigInt
  assignment_id     BigInt?            @db.UnsignedBigInt
  invoice_number    String             @unique(map: "invoice_number") @db.VarChar(100)
  amount            Decimal            @db.Decimal(12, 2)
  currency          String?            @default("USD") @db.VarChar(10)
  billing_cycle     String?            @db.VarChar(100)
  due_date          DateTime?          @db.Date
  status            String?            @default("unpaid") @db.VarChar(100)
  created_by        BigInt?            @db.UnsignedBigInt
  stripe_payment_intent_id String?            @db.VarChar(255)
  stripe_checkout_session_id String?          @db.VarChar(255)
  created_at        DateTime?          @default(now()) @db.Timestamp(0)
  updated_at        DateTime?          @default(now()) @db.Timestamp(0)
  invoice_receipts  invoice_receipts[]
  client_profiles   client_profiles    @relation(fields: [client_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoices_ibfk_1")
  assignments       assignments?       @relation(fields: [assignment_id], references: [id], onUpdate: NoAction, map: "invoices_ibfk_2")
  users             users?             @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "invoices_ibfk_3")

  @@index([assignment_id], map: "assignment_id")
  @@index([client_profile_id], map: "client_profile_id")
  @@index([created_by], map: "created_by")
}

model logs {
  id                                BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  log_type                          String            @db.VarChar(100)
  related_user_id                   BigInt?           @db.UnsignedBigInt
  related_job_post_id               BigInt?           @db.UnsignedBigInt
  related_job_application_id        BigInt?           @db.UnsignedBigInt
  related_assignment_id             BigInt?           @db.UnsignedBigInt
  related_payment_id                BigInt?           @db.UnsignedBigInt
  title                             String            @db.VarChar(255)
  description                       String?           @db.Text
  attachment_url                    String?           @db.Text
  status                            String?           @default("active") @db.VarChar(100)
  created_by                        BigInt?           @db.UnsignedBigInt
  created_at                        DateTime?         @default(now()) @db.Timestamp(0)
  users_logs_related_user_idTousers users?            @relation("logs_related_user_idTousers", fields: [related_user_id], references: [id], onUpdate: NoAction, map: "logs_ibfk_1")
  job_posts                         job_posts?        @relation(fields: [related_job_post_id], references: [id], onUpdate: NoAction, map: "logs_ibfk_2")
  job_applications                  job_applications? @relation(fields: [related_job_application_id], references: [id], onUpdate: NoAction, map: "logs_ibfk_3")
  assignments                       assignments?      @relation(fields: [related_assignment_id], references: [id], onUpdate: NoAction, map: "logs_ibfk_4")
  payments                          payments?         @relation(fields: [related_payment_id], references: [id], onUpdate: NoAction, map: "logs_ibfk_5")
  users_logs_created_byTousers      users?            @relation("logs_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "logs_ibfk_6")

  @@index([created_by], map: "created_by")
  @@index([related_assignment_id], map: "related_assignment_id")
  @@index([related_user_id], map: "related_user_id")
  @@index([related_job_application_id], map: "related_job_application_id")
  @@index([related_job_post_id], map: "related_job_post_id")
  @@index([related_payment_id], map: "related_payment_id")
}

model niches {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name        String        @unique(map: "name") @db.VarChar(150)
  description String?       @db.Text
  status      String?       @default("active") @db.VarChar(50)
  created_at  DateTime?     @default(now()) @db.Timestamp(0)
  job_posts   job_posts[]
  va_profiles va_profiles[]
}

model notice_recipients {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  notice_id   BigInt    @db.UnsignedBigInt
  user_id     BigInt    @db.UnsignedBigInt
  read_status String?   @default("unread") @db.VarChar(50)
  read_at     DateTime? @db.Timestamp(0)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  notices     notices   @relation(fields: [notice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notice_recipients_ibfk_1")
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notice_recipients_ibfk_2")

  @@unique([notice_id, user_id], map: "notice_id")
  @@index([user_id], map: "user_id")
}

model notices {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  title             String              @db.VarChar(255)
  message           String              @db.Text
  audience_type     String              @db.VarChar(100)
  priority          String?             @default("normal") @db.VarChar(50)
  publish_date      DateTime?           @db.Date
  attachment_url    String?             @db.Text
  created_by        BigInt?             @db.UnsignedBigInt
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  notice_recipients notice_recipients[]
  users             users?              @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "notices_ibfk_1")

  @@index([created_by], map: "created_by")
}

model roles {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name        String       @unique(map: "name") @db.VarChar(100)
  description String?      @db.Text
  created_at  DateTime?    @default(now()) @db.Timestamp(0)
  user_roles  user_roles[]
}

model skills {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  name            String            @unique(map: "name") @db.VarChar(150)
  category        String?           @db.VarChar(100)
  status          String?           @default("active") @db.VarChar(50)
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  job_post_skills job_post_skills[]
  va_skills       va_skills[]
}

model user_roles {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  role_id    BigInt    @db.UnsignedBigInt
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_roles_ibfk_1")
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_roles_ibfk_2")

  @@unique([user_id, role_id], map: "user_id")
  @@index([role_id], map: "role_id")
}

model users {
  id                                                   BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  full_name                                            String?              @db.VarChar(150)
  email                                                String               @unique(map: "email") @db.VarChar(150)
  password_hash                                        String               @db.VarChar(255)
  phone                                                String?              @db.VarChar(50)
  account_status                                       String?              @default("active") @db.VarChar(50)
  profile_photo_url                                    String?              @db.LongText
  stripe_customer_id                                   String?              @db.VarChar(255)
  stripe_subscription_id                               String?              @db.VarChar(255)
  created_at                                           DateTime?            @default(now()) @db.Timestamp(0)
  updated_at                                           DateTime?            @default(now()) @db.Timestamp(0)
  assignments                                          assignments[]
  client_profiles                                      client_profiles?
  commissions                                          commissions[]
  contracts                                            contracts[]
  discovery_calls                                      discovery_calls[]
  interviews_interviews_scheduled_byTousers            interviews[]         @relation("interviews_scheduled_byTousers")
  interviews_interviews_interviewer_user_idTousers     interviews[]         @relation("interviews_interviewer_user_idTousers")
  invoice_receipts_invoice_receipts_uploaded_byTousers invoice_receipts[]   @relation("invoice_receipts_uploaded_byTousers")
  invoice_receipts_invoice_receipts_verified_byTousers invoice_receipts[]   @relation("invoice_receipts_verified_byTousers")
  invoices                                             invoices[]
  job_posts                                            job_posts[]
  learning_access_learning_access_user_idTousers       learning_access[]    @relation("learning_access_user_idTousers")
  learning_access_learning_access_granted_byTousers    learning_access[]    @relation("learning_access_granted_byTousers")
  logs_logs_related_user_idTousers                     logs[]               @relation("logs_related_user_idTousers")
  logs_logs_created_byTousers                          logs[]               @relation("logs_created_byTousers")
  notice_recipients                                    notice_recipients[]
  notices                                              notices[]
  payment_proofs                                       payment_proofs[]
  payments_payments_payer_user_idTousers               payments[]           @relation("payments_payer_user_idTousers")
  payments_payments_verified_byTousers                 payments[]           @relation("payments_verified_byTousers")
  payout_methods                                       payout_methods[]
  payouts_payouts_recipient_user_idTousers             payouts[]            @relation("payouts_recipient_user_idTousers")
  payouts_payouts_processed_byTousers                  payouts[]            @relation("payouts_processed_byTousers")
  shortlists                                           shortlists[]
  student_profiles                                     student_profiles?
  trainer_profiles                                     trainer_profiles?
  training_materials                                   training_materials[]
  training_purchases                                   training_purchases[]
  user_roles                                           user_roles[]
  va_profiles                                          va_profiles?

  @@index([email], map: "idx_users_email")
}

model va_profiles {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id               BigInt                  @unique(map: "user_id") @db.UnsignedBigInt
  preferred_niche_id    BigInt?                 @db.UnsignedBigInt
  headline              String?                 @db.VarChar(255)
  bio                   String?                 @db.Text
  location              String?                 @db.VarChar(255)
  experience_level      String?                 @db.VarChar(100)
  preferred_role        String?                 @db.VarChar(150)
  expected_hourly_rate  Decimal?                @db.Decimal(10, 2)
  availability_summary  String?                 @db.VarChar(255)
  work_shift            String?                 @db.VarChar(100)
  profile_visibility    String?                 @default("private") @db.VarChar(50)
  profile_status        String?                 @default("draft") @db.VarChar(100)
  created_at            DateTime?               @default(now()) @db.Timestamp(0)
  updated_at            DateTime?               @default(now()) @db.Timestamp(0)
  assignments           assignments[]
  contracts             contracts[]
  job_applications      job_applications[]
  va_availability_slots va_availability_slots[]
  va_portfolios         va_portfolios[]
  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "va_profiles_ibfk_1")
  niches                niches?                 @relation(fields: [preferred_niche_id], references: [id], onUpdate: NoAction, map: "va_profiles_ibfk_2")
  va_skills             va_skills[]
  va_tools              va_tools[]

  @@index([preferred_niche_id], map: "preferred_niche_id")
}

model va_skills {
  id                BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  va_profile_id     BigInt      @db.UnsignedBigInt
  skill_id          BigInt      @db.UnsignedBigInt
  proficiency_level String?     @db.VarChar(50)
  created_at        DateTime?   @default(now()) @db.Timestamp(0)
  va_profiles       va_profiles @relation(fields: [va_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "va_skills_ibfk_1")
  skills            skills      @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "va_skills_ibfk_2")

  @@unique([va_profile_id, skill_id], map: "va_profile_id")
  @@index([skill_id], map: "skill_id")
}

model commissions {
  id                         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  payment_id                 BigInt    @db.UnsignedBigInt
  recipient_user_id          BigInt    @db.UnsignedBigInt
  recipient_type             String    @db.VarChar(100)
  gross_amount               Decimal   @db.Decimal(12, 2)
  platform_commission_rate   Decimal?  @default(30.00) @db.Decimal(5, 2)
  platform_commission_amount Decimal   @db.Decimal(12, 2)
  recipient_amount           Decimal   @db.Decimal(12, 2)
  status                     String?   @default("pending") @db.VarChar(100)
  created_at                 DateTime? @default(now()) @db.Timestamp(0)
  payments                   payments  @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "commissions_ibfk_1")
  users                      users     @relation(fields: [recipient_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "commissions_ibfk_2")
  payouts                    payouts[]

  @@index([payment_id], map: "payment_id")
  @@index([recipient_user_id], map: "recipient_user_id")
}

model discovery_calls {
  id                   BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  client_profile_id    BigInt          @db.UnsignedBigInt
  requested_date       DateTime?       @db.Date
  requested_time       DateTime?       @db.Time(0)
  scheduled_at         DateTime?       @db.DateTime(0)
  meeting_link         String?         @db.Text
  assigned_employee_id BigInt?         @db.UnsignedBigInt
  status               String?         @default("requested") @db.VarChar(100)
  notes                String?         @db.Text
  created_at           DateTime?       @default(now()) @db.Timestamp(0)
  updated_at           DateTime?       @default(now()) @db.Timestamp(0)
  client_profiles      client_profiles @relation(fields: [client_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "discovery_calls_ibfk_1")
  users                users?          @relation(fields: [assigned_employee_id], references: [id], onUpdate: NoAction, map: "discovery_calls_ibfk_2")
  payments             payments[]

  @@index([assigned_employee_id], map: "assigned_employee_id")
  @@index([client_profile_id], map: "client_profile_id")
  @@index([status], map: "idx_discovery_calls_status")
}

model job_applications {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  job_post_id   BigInt        @db.UnsignedBigInt
  va_profile_id BigInt        @db.UnsignedBigInt
  status        String?       @default("applied") @db.VarChar(100)
  cover_message String?       @db.Text
  match_score   Decimal?      @db.Decimal(5, 2)
  match_reasons Json?
  admin_remarks String?       @db.Text
  applied_at    DateTime?     @default(now()) @db.Timestamp(0)
  updated_at    DateTime?     @default(now()) @db.Timestamp(0)
  assignments   assignments[]
  interviews    interviews[]
  job_posts     job_posts     @relation(fields: [job_post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "job_applications_ibfk_1")
  va_profiles   va_profiles   @relation(fields: [va_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "job_applications_ibfk_2")
  logs          logs[]
  shortlists    shortlists?

  @@unique([job_post_id, va_profile_id], map: "job_post_id")
  @@index([job_post_id], map: "idx_job_applications_job")
  @@index([status], map: "idx_job_applications_status")
  @@index([va_profile_id], map: "idx_job_applications_va")
}

model job_post_skills {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  job_post_id BigInt    @db.UnsignedBigInt
  skill_id    BigInt    @db.UnsignedBigInt
  job_posts   job_posts @relation(fields: [job_post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "job_post_skills_ibfk_1")
  skills      skills    @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "job_post_skills_ibfk_2")

  @@unique([job_post_id, skill_id], map: "job_post_id")
  @@index([skill_id], map: "skill_id")
}

model job_post_tools {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  job_post_id BigInt    @db.UnsignedBigInt
  tool_id     BigInt    @db.UnsignedBigInt
  job_posts   job_posts @relation(fields: [job_post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "job_post_tools_ibfk_1")
  tools       tools     @relation(fields: [tool_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "job_post_tools_ibfk_2")

  @@unique([job_post_id, tool_id], map: "job_post_id")
  @@index([tool_id], map: "tool_id")
}

model job_posts {
  id                         BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  client_profile_id          BigInt             @db.UnsignedBigInt
  niche_id                   BigInt?            @db.UnsignedBigInt
  job_title                  String             @db.VarChar(255)
  job_description            String             @db.Text
  role_needed                String?            @db.VarChar(150)
  work_schedule              String?            @db.VarChar(255)
  work_shift                 String?            @db.VarChar(100)
  timezone                   String?            @db.VarChar(100)
  client_hourly_rate         Decimal            @db.Decimal(10, 2)
  va_hourly_rate             Decimal            @db.Decimal(10, 2)
  platform_commission_rate   Decimal?           @default(30.00) @db.Decimal(5, 2)
  platform_hourly_commission Decimal            @db.Decimal(10, 2)
  currency                   String?            @default("USD") @db.VarChar(10)
  status                     String?            @default("pending_review") @db.VarChar(100)
  reviewed_by                BigInt?            @db.UnsignedBigInt
  reviewed_at                DateTime?          @db.Timestamp(0)
  admin_remarks              String?            @db.Text
  created_at                 DateTime?          @default(now()) @db.Timestamp(0)
  updated_at                 DateTime?          @default(now()) @db.Timestamp(0)
  assignments                assignments[]
  job_applications           job_applications[]
  job_post_skills            job_post_skills[]
  job_post_tools             job_post_tools[]
  client_profiles            client_profiles    @relation(fields: [client_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "job_posts_ibfk_1")
  niches                     niches?            @relation(fields: [niche_id], references: [id], onUpdate: NoAction, map: "job_posts_ibfk_2")
  users                      users?             @relation(fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "job_posts_ibfk_3")
  logs                       logs[]
  payments                   payments[]

  @@index([client_profile_id], map: "idx_job_posts_client")
  @@index([status], map: "idx_job_posts_status")
  @@index([niche_id], map: "niche_id")
  @@index([reviewed_by], map: "reviewed_by")
}

model learning_access {
  id                                      BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                                 BigInt             @db.UnsignedBigInt
  training_material_id                    BigInt             @db.UnsignedBigInt
  access_status                           String?            @default("active") @db.VarChar(100)
  granted_by                              BigInt?            @db.UnsignedBigInt
  granted_at                              DateTime?          @default(now()) @db.Timestamp(0)
  users_learning_access_user_idTousers    users              @relation("learning_access_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "learning_access_ibfk_1")
  training_materials                      training_materials @relation(fields: [training_material_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "learning_access_ibfk_2")
  users_learning_access_granted_byTousers users?             @relation("learning_access_granted_byTousers", fields: [granted_by], references: [id], onUpdate: NoAction, map: "learning_access_ibfk_3")

  @@unique([user_id, training_material_id], map: "user_id")
  @@index([granted_by], map: "granted_by")
  @@index([training_material_id], map: "training_material_id")
}

model payment_proofs {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  payment_id  BigInt    @db.UnsignedBigInt
  file_url    String    @db.Text
  file_name   String?   @db.VarChar(255)
  uploaded_by BigInt?   @db.UnsignedBigInt
  remarks     String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  payments    payments  @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payment_proofs_ibfk_1")
  users       users?    @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "payment_proofs_ibfk_2")

  @@index([payment_id], map: "payment_id")
  @@index([uploaded_by], map: "uploaded_by")
}

model payments {
  id                                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  payer_user_id                       BigInt               @db.UnsignedBigInt
  payment_type                        String               @db.VarChar(100)
  related_job_post_id                 BigInt?              @db.UnsignedBigInt
  related_training_material_id        BigInt?              @db.UnsignedBigInt
  related_discovery_call_id           BigInt?              @db.UnsignedBigInt
  amount_paid                         Decimal              @db.Decimal(12, 2)
  currency                            String?              @default("USD") @db.VarChar(10)
  status                              String?              @default("pending") @db.VarChar(100)
  payment_method                      String?              @db.VarChar(100)
  reference_number                    String?              @db.VarChar(150)
  remarks                             String?              @db.Text
  verified_by                         BigInt?              @db.UnsignedBigInt
  verified_at                         DateTime?            @db.Timestamp(0)
  created_at                          DateTime?            @default(now()) @db.Timestamp(0)
  updated_at                          DateTime?            @default(now()) @db.Timestamp(0)
  commissions                         commissions[]
  invoice_receipts                    invoice_receipts[]
  logs                                logs[]
  payment_proofs                      payment_proofs[]
  users_payments_payer_user_idTousers users                @relation("payments_payer_user_idTousers", fields: [payer_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payments_ibfk_1")
  job_posts                           job_posts?           @relation(fields: [related_job_post_id], references: [id], onUpdate: NoAction, map: "payments_ibfk_2")
  training_materials                  training_materials?  @relation(fields: [related_training_material_id], references: [id], onUpdate: NoAction, map: "payments_ibfk_3")
  discovery_calls                     discovery_calls?     @relation(fields: [related_discovery_call_id], references: [id], onUpdate: NoAction, map: "payments_ibfk_4")
  users_payments_verified_byTousers   users?               @relation("payments_verified_byTousers", fields: [verified_by], references: [id], onUpdate: NoAction, map: "payments_ibfk_5")
  training_purchases                  training_purchases[]

  @@index([status], map: "idx_payments_status")
  @@index([payer_user_id], map: "payer_user_id")
  @@index([related_discovery_call_id], map: "related_discovery_call_id")
  @@index([related_job_post_id], map: "related_job_post_id")
  @@index([related_training_material_id], map: "related_training_material_id")
  @@index([verified_by], map: "verified_by")
}

model payout_methods {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  method_type    String    @db.VarChar(100)
  account_name   String?   @db.VarChar(150)
  masked_details String?   @db.VarChar(255)
  status         String?   @default("active") @db.VarChar(50)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payout_methods_ibfk_1")
  payouts        payouts[]

  @@index([user_id], map: "user_id")
}

model payouts {
  id                                     BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  commission_id                          BigInt?         @db.UnsignedBigInt
  recipient_user_id                      BigInt          @db.UnsignedBigInt
  recipient_type                         String          @db.VarChar(100)
  amount                                 Decimal         @db.Decimal(12, 2)
  currency                               String?         @default("USD") @db.VarChar(10)
  payout_method_id                       BigInt?         @db.UnsignedBigInt
  status                                 String?         @default("pending") @db.VarChar(100)
  processed_by                           BigInt?         @db.UnsignedBigInt
  processed_at                           DateTime?       @db.Timestamp(0)
  reference_number                       String?         @db.VarChar(150)
  remarks                                String?         @db.Text
  created_at                             DateTime?       @default(now()) @db.Timestamp(0)
  updated_at                             DateTime?       @default(now()) @db.Timestamp(0)
  commissions                            commissions?    @relation(fields: [commission_id], references: [id], onUpdate: NoAction, map: "payouts_ibfk_1")
  users_payouts_recipient_user_idTousers users           @relation("payouts_recipient_user_idTousers", fields: [recipient_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payouts_ibfk_2")
  payout_methods                         payout_methods? @relation(fields: [payout_method_id], references: [id], onUpdate: NoAction, map: "payouts_ibfk_3")
  users_payouts_processed_byTousers      users?          @relation("payouts_processed_byTousers", fields: [processed_by], references: [id], onUpdate: NoAction, map: "payouts_ibfk_4")

  @@index([commission_id], map: "commission_id")
  @@index([status], map: "idx_payouts_status")
  @@index([payout_method_id], map: "payout_method_id")
  @@index([processed_by], map: "processed_by")
  @@index([recipient_user_id], map: "recipient_user_id")
}

model shortlists {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  job_application_id BigInt           @unique(map: "job_application_id") @db.UnsignedBigInt
  client_profile_id  BigInt           @db.UnsignedBigInt
  shortlisted_by     BigInt?          @db.UnsignedBigInt
  status             String?          @default("shortlisted") @db.VarChar(100)
  client_decision    String?          @default("pending") @db.VarChar(100)
  remarks            String?          @db.Text
  created_at         DateTime?        @default(now()) @db.Timestamp(0)
  updated_at         DateTime?        @default(now()) @db.Timestamp(0)
  job_applications   job_applications @relation(fields: [job_application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shortlists_ibfk_1")
  client_profiles    client_profiles  @relation(fields: [client_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shortlists_ibfk_2")
  users              users?           @relation(fields: [shortlisted_by], references: [id], onUpdate: NoAction, map: "shortlists_ibfk_3")

  @@index([client_profile_id], map: "client_profile_id")
  @@index([shortlisted_by], map: "shortlisted_by")
}

model student_profiles {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt    @unique(map: "user_id") @db.UnsignedBigInt
  learning_goal String?   @db.Text
  status        String?   @default("active") @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "student_profiles_ibfk_1")
}

model tools {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name           String           @unique(map: "name") @db.VarChar(150)
  category       String?          @db.VarChar(100)
  status         String?          @default("active") @db.VarChar(50)
  created_at     DateTime?        @default(now()) @db.Timestamp(0)
  job_post_tools job_post_tools[]
  va_tools       va_tools[]
}

model trainer_profiles {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  user_id            BigInt               @unique(map: "user_id") @db.UnsignedBigInt
  bio                String?              @db.Text
  expertise          String?              @db.Text
  status             String?              @default("active") @db.VarChar(100)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @default(now()) @db.Timestamp(0)
  users              users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trainer_profiles_ibfk_1")
  training_materials training_materials[]
}

model training_categories {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  name               String               @unique(map: "name") @db.VarChar(150)
  description        String?              @db.Text
  status             String?              @default("active") @db.VarChar(50)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  training_materials training_materials[]
}

model training_material_files {
  id                   BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  training_material_id BigInt             @db.UnsignedBigInt
  file_name            String?            @db.VarChar(255)
  file_url             String             @db.Text
  file_type            String?            @db.VarChar(100)
  created_at           DateTime?          @default(now()) @db.Timestamp(0)
  training_materials   training_materials @relation(fields: [training_material_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "training_material_files_ibfk_1")

  @@index([training_material_id], map: "training_material_id")
}

model training_materials {
  id                       BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  trainer_profile_id       BigInt                    @db.UnsignedBigInt
  category_id              BigInt?                   @db.UnsignedBigInt
  title                    String                    @db.VarChar(255)
  description              String?                   @db.Text
  price                    Decimal?                  @default(0.00) @db.Decimal(10, 2)
  currency                 String?                   @default("USD") @db.VarChar(10)
  thumbnail_url            String?                   @db.Text
  material_url             String?                   @db.Text
  status                   String?                   @default("draft") @db.VarChar(100)
  platform_commission_rate Decimal?                  @default(30.00) @db.Decimal(5, 2)
  reviewed_by              BigInt?                   @db.UnsignedBigInt
  reviewed_at              DateTime?                 @db.Timestamp(0)
  admin_remarks            String?                   @db.Text
  created_at               DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                 @default(now()) @db.Timestamp(0)
  learning_access          learning_access[]
  payments                 payments[]
  training_material_files  training_material_files[]
  trainer_profiles         trainer_profiles          @relation(fields: [trainer_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "training_materials_ibfk_1")
  training_categories      training_categories?      @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "training_materials_ibfk_2")
  users                    users?                    @relation(fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "training_materials_ibfk_3")
  training_purchases       training_purchases[]

  @@index([category_id], map: "category_id")
  @@index([status], map: "idx_training_materials_status")
  @@index([reviewed_by], map: "reviewed_by")
  @@index([trainer_profile_id], map: "trainer_profile_id")
}

model training_purchases {
  id                   BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  training_material_id BigInt             @db.UnsignedBigInt
  buyer_user_id        BigInt             @db.UnsignedBigInt
  payment_id           BigInt?            @db.UnsignedBigInt
  amount_paid          Decimal            @db.Decimal(10, 2)
  access_status        String?            @default("locked") @db.VarChar(100)
  purchased_at         DateTime?          @default(now()) @db.Timestamp(0)
  training_materials   training_materials @relation(fields: [training_material_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "training_purchases_ibfk_1")
  users                users              @relation(fields: [buyer_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "training_purchases_ibfk_2")
  payments             payments?          @relation(fields: [payment_id], references: [id], onUpdate: NoAction, map: "training_purchases_ibfk_3")

  @@index([buyer_user_id], map: "buyer_user_id")
  @@index([payment_id], map: "payment_id")
  @@index([training_material_id], map: "training_material_id")
}

model va_availability_slots {
  id                BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  va_profile_id     BigInt      @db.UnsignedBigInt
  day_of_week       String?     @db.VarChar(20)
  start_time        DateTime?   @db.Time(0)
  end_time          DateTime?   @db.Time(0)
  timezone          String?     @db.VarChar(100)
  availability_type String?     @db.VarChar(100)
  created_at        DateTime?   @default(now()) @db.Timestamp(0)
  va_profiles       va_profiles @relation(fields: [va_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "va_availability_slots_ibfk_1")

  @@index([va_profile_id], map: "va_profile_id")
}

model va_portfolios {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  va_profile_id BigInt      @db.UnsignedBigInt
  title         String      @db.VarChar(255)
  description   String?     @db.Text
  file_url      String?     @db.Text
  external_link String?     @db.Text
  created_at    DateTime?   @default(now()) @db.Timestamp(0)
  va_profiles   va_profiles @relation(fields: [va_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "va_portfolios_ibfk_1")

  @@index([va_profile_id], map: "va_profile_id")
}

model va_tools {
  id                BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  va_profile_id     BigInt      @db.UnsignedBigInt
  tool_id           BigInt      @db.UnsignedBigInt
  proficiency_level String?     @db.VarChar(50)
  created_at        DateTime?   @default(now()) @db.Timestamp(0)
  va_profiles       va_profiles @relation(fields: [va_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "va_tools_ibfk_1")
  tools             tools       @relation(fields: [tool_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "va_tools_ibfk_2")

  @@unique([va_profile_id, tool_id], map: "va_profile_id")
  @@index([tool_id], map: "tool_id")
}
